{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [".env", ".env.local"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "PORT",
    "HOST",
    "CORS_ORIGIN",
    "LOG_LEVEL",
    "BETTER_AUTH_URL",
    "BETTER_AUTH_SECRET",
    "WORKER_PORT",
    "WORKER_HOST",
    "WORKER_URL",
    "MAX_CONCURRENT_SCANS",
    "DEFAULT_MAX_PAGES",
    "AI_PROVIDER",
    "AI_MODEL",
    "GEMINI_API_KEY",
    "GEMINI_MODEL",
    "OPENAI_API_KEY",
    "OPENAI_MODEL",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_BUCKET_NAME",
    "R2_PUBLIC_URL",
    "API_URL",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_CDN_URL",
    "NEXT_PUBLIC_R2_PUBLIC_URL"
  ],
  "tasks": {

    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
