# ==============================================================================
# ROVE MONOREPO UNIFIED ENVIRONMENT CONFIGURATION
# Copy this file to '.env' at the root: cp .env.example .env
# All apps (api, worker, web, database) automatically read from this root .env file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & POSTGRESQL (Used by @repo/database, api, worker)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rove

# ------------------------------------------------------------------------------
# 2. FASTIFY API GATEWAY (apps/api - Port 4000)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=*
LOG_LEVEL=info
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_SECRET=change-this-to-a-secure-random-secret-key-min-32-chars

# ------------------------------------------------------------------------------
# 3. WORKER & BROWSER CRAWLER ENGINE (apps/worker - Port 4001)
# ------------------------------------------------------------------------------
WORKER_PORT=4001
WORKER_HOST=0.0.0.0
WORKER_URL=http://localhost:4001
MAX_CONCURRENT_SCANS=3
DEFAULT_MAX_PAGES=100

# ------------------------------------------------------------------------------
# 4. GOOGLE GEMINI AI QA DIAGNOSTICS (Used by ai-advisor in worker & api)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# 5. STORAGE & MEDIA (Cloudflare R2 or Local fallback)
# ------------------------------------------------------------------------------
# If left empty, screenshots and session videos are saved locally to apps/worker/public
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=rove-screenshots
R2_PUBLIC_URL=

# ------------------------------------------------------------------------------
# 6. NEXT.JS FRONTEND DASHBOARD (apps/web - Port 3000)
# ------------------------------------------------------------------------------
API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CDN_URL=http://localhost:4001
NEXT_PUBLIC_R2_PUBLIC_URL=
